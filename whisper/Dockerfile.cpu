FROM ubuntu:22.04

# Build dependencies
RUN apt-get update && apt-get install -y \
    git \
    cmake \
    build-essential \
    ffmpeg \
    python3 \
    python3-pip \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Bootstrap uv via pip — auditable, no remote script execution.
RUN pip3 install --no-cache-dir uv

WORKDIR /app

# Build whisper.cpp for CPU (no special flags)
RUN git clone https://github.com/ggerganov/whisper.cpp.git . && \
    mkdir build && cd build && \
    cmake .. && \
    make -j$(nproc)

# Download the model (default small, can be overridden at runtime).
# The Silero VAD model is downloaded at container start (see entrypoint.sh)
# rather than baked into the image, because /app/models is a runtime volume
# that would shadow anything copied into that path at build time.
RUN /app/models/download-ggml-model.sh small /app/models

# Patch-independent Python packages for the proxy.  Installed before the
# diarize-patches COPY so that editing the patch does not invalidate the
# (expensive) torch install layer.
RUN uv pip install --system --no-cache fastapi uvicorn python-multipart requests httpx soundfile \
    && uv pip install --system --no-cache torch torchaudio --index-url https://download.pytorch.org/whl/cpu

# diarize is installed from a pinned upstream checkout with a local patch
# applied at build time (parallel embedding extraction) — see
# whisper/diarize-patches/.  Changing the patch only invalidates this layer.
ARG DIARIZE_REF=v0.1.2
COPY diarize-patches /tmp/diarize-patches
RUN git clone --depth 1 --branch "${DIARIZE_REF}" https://github.com/notch-up/diarize.git /tmp/diarize \
    && cp /tmp/diarize-patches/embeddings.py /tmp/diarize/src/diarize/embeddings.py \
    && uv pip install --system --no-cache /tmp/diarize \
    && rm -rf /tmp/diarize /tmp/diarize-patches

# Copy proxy and entrypoint
COPY openai_proxy.py /app/openai_proxy.py
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# No GPU-specific env vars
ENV WHISPER_BACKEND=cpu

EXPOSE 9091
ENTRYPOINT ["/app/entrypoint.sh"]
