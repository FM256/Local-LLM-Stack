#!/usr/bin/env python3
"""
transcribe.py - Transcribe audio from a local file or YouTube URL using whisper-server.

Usage:
    ./transcribe.py [--language LANG] [--server URL] [--output-format {text,json,srt}]
                    [--diarize] [--num-speakers N] <input>

    <input>           : path to a local audio/video file, or a YouTube URL.
    --language, -l    : ISO-639-1 language code (e.g., 'de') to hint the model.
    --server          : base URL of whisper-server REST API (default: http://localhost:9091).
    --output-format, -f : output format: text (default), json (verbose_json with timestamps), or srt.
    --diarize, -d     : enable speaker diarization (adds speaker labels to segments).
    --num-speakers, -n : number of speakers (auto‑detect if omitted, only used with --diarize).
    --estimate-factor : manually override the compute factor (seconds per second of audio).
    --help, -h        : show this help.

All status output goes to stderr; only the final transcript is printed to stdout.
"""

import argparse
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
from urllib.parse import urlparse

import requests

DEFAULT_SERVER = "http://localhost:9091"
TRANSCRIPT_ENDPOINT = "/v1/audio/transcriptions"
STREAM_ENDPOINT = "/v1/audio/transcriptions/stream"


def is_url(string: str) -> bool:
    try:
        result = urlparse(string)
        return all([result.scheme, result.netloc])
    except Exception:
        return False


def check_dependency(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def log(msg: str) -> None:
    print(msg, file=sys.stderr)


def get_audio_duration(file_path: str) -> float:
    if not check_dependency("ffprobe"):
        log("Warning: ffprobe not available, cannot estimate time.")
        return 0.0
    cmd = [
        "ffprobe",
        "-v",
        "error",
        "-show_entries",
        "format=duration",
        "-of",
        "default=noprint_wrappers=1:nokey=1",
        file_path,
    ]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        return float(result.stdout.strip())
    except Exception:
        log("Warning: could not read audio duration for time estimate.")
        return 0.0


def get_backend(server_url: str) -> str:
    try:
        resp = requests.get(server_url.rstrip("/") + "/backend", timeout=5)
        if resp.status_code == 200:
            data = resp.json()
            return data.get("backend", "unknown")
    except Exception:
        pass
    return "unknown"


def download_youtube_audio(url: str, output_dir: str) -> str:
    if not check_dependency("yt-dlp"):
        raise RuntimeError("yt-dlp is not installed.")
    # Use a generic base name – yt‑dlp will add the correct extension
    base_path = os.path.join(output_dir, "audio.%(ext)s")
    cmd = [
        "yt-dlp",
        "-f",
        "bestaudio/best[ext=mp4]/best",
        "--no-playlist",
        "--extractor-args",  # Use android client to decrease likelihood of lockouts and rate limiting.
        "youtube:player_client=android",  # This gives lower quality video and audio, but thats completely fine for transcribing
        "--impersonate",  # Use curl_cffi & curl_impersonate to impersonate a real browser to avoid lockouts
        "chrome",
        "--sleep-requests",  # Further arguments to avoid rate limiting and lockouts
        "0.5",
        "--sleep-interval",
        "0.5",
        "--max-sleep-interval",
        "2",
        "-o",
        base_path,
        url,
    ]
    result = subprocess.run(cmd, capture_output=True, text=True, cwd=output_dir)
    if result.returncode != 0:
        raise RuntimeError(f"yt-dlp failed:\n{result.stderr}")
    pattern = os.path.join(output_dir, "audio.*")
    files = glob.glob(pattern)
    if not files:
        raise RuntimeError(f"No audio file created with pattern: {pattern}")
    if len(files) > 1:
        raise RuntimeError(f"Multiple audio files found: {files}")
    return files[0]


def get_ffaudio_path() -> str:
    """Return path to ffaudio executable, either from FFAUDIO_PATH env or found in PATH."""
    env_path = os.environ.get("FFAUDIO_PATH")
    if env_path:
        if os.path.isfile(env_path) and os.access(env_path, os.X_OK):
            return env_path
        raise RuntimeError(f"FFAUDIO_PATH points to non‑executable file: {env_path}")
    which = shutil.which("ffaudio")
    if which:
        return which
    raise RuntimeError("ffaudio not found. Install it or set FFAUDIO_PATH.")


def extract_audio_with_ffaudio(input_file: str, output_dir: str) -> str:
    """
    Run ffaudio on input_file (must already be in output_dir or accessible).
    Returns the path to the extracted audio file.
    """
    ff = get_ffaudio_path()
    cmd = [ff, input_file]
    result = subprocess.run(cmd, cwd=output_dir, capture_output=True, text=True)

    if result.returncode != 0:
        log(f"ffaudio stderr: {result.stderr}")
        raise RuntimeError(f"ffaudio extraction failed (exit {result.returncode})")

    # Parse the success line: "✅ Successfully extracted audio to '<path>'"
    output_file = None
    for line in result.stdout.splitlines():
        if "Successfully extracted audio to" in line:
            match = re.search(r"'([^']+)'", line)
            if match:
                output_file = match.group(1)
                break

    if not output_file:
        raise RuntimeError("Could not determine extracted audio file from ffaudio output.")

    if not os.path.isfile(output_file):
        raise RuntimeError(f"Extracted audio file '{output_file}' not found.")
    if not os.path.isabs(output_file):
        output_file = os.path.join(output_dir, output_file)

    log(f"🎵 Extracted audio: {os.path.basename(output_file)}")
    return output_file


def fallback_reencode_to_wav(input_file: str, output_dir: str) -> str:
    """
    Fallback: re‑encode input file to 16 kHz mono PCM WAV using ffmpeg.
    Returns path to the WAV file.
    """
    if not check_dependency("ffmpeg"):
        raise RuntimeError("ffmpeg is not installed, cannot fallback re‑encoding.")
    base = os.path.splitext(os.path.basename(input_file))[0]
    wav_path = os.path.join(output_dir, f"{base}.wav")
    cmd = [
        "ffmpeg",
        "-i",
        input_file,
        "-vn",
        "-ar",
        "16000",
        "-ac",
        "1",
        "-c:a",
        "pcm_s16le",
        "-y",
        wav_path,
    ]
    log(f"Fallback re‑encoding to WAV: {' '.join(cmd)}")
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(f"ffmpeg re‑encoding failed: {result.stderr}")
    if not os.path.isfile(wav_path) or os.path.getsize(wav_path) == 0:
        raise RuntimeError("ffmpeg produced empty or missing WAV file.")
    return wav_path


def obtain_audio(input_str: str, temp_dir: str) -> str:
    if is_url(input_str):
        log(f"📥 Downloading audio from URL: {input_str}")
        downloaded = download_youtube_audio(input_str, temp_dir)
        # Always run ffaudio; it handles already‑audio case safely.
        return extract_audio_with_ffaudio(downloaded, temp_dir)

    if not os.path.isfile(input_str):
        raise FileNotFoundError(f"File not found: {input_str}")

    # Copy local file to temp_dir so everything stays together
    dest = os.path.join(temp_dir, os.path.basename(input_str))
    if os.path.abspath(input_str) != os.path.abspath(dest):
        shutil.copy2(input_str, dest)

    try:
        return extract_audio_with_ffaudio(dest, temp_dir)
    except Exception as e:
        log(f"ffaudio extraction failed: {e}. Falling back to re‑encoding.")
        return fallback_reencode_to_wav(dest, temp_dir)


def transcribe_file(
    file_path: str,
    server_url: str,
    language: str = None,
    output_format: str = "text",
    diarize: bool = False,
    num_speakers: int = None,
) -> str:
    url = server_url.rstrip("/") + TRANSCRIPT_ENDPOINT
    with open(file_path, "rb") as f:
        files = {"file": (os.path.basename(file_path), f, "audio/mpeg")}
        data = {"response_format": output_format}
        if language:
            data["language"] = language
        if diarize:
            data["diarize"] = "true"
            if num_speakers is not None:
                data["num_speakers"] = str(num_speakers)

        try:
            resp = requests.post(url, files=files, data=data, timeout=3600)
        except requests.exceptions.RequestException as e:
            raise RuntimeError(f"Request failed: {e}")

    if resp.status_code != 200:
        raise RuntimeError(f"Server returned {resp.status_code}: {resp.text}")
    return resp.text


#: Matches whisper-cli segment lines: "[HH:MM:SS.mmm --> HH:MM:SS.mmm] text"
#: (whisper.cpp uses '.'; older/other builds use ','). We only need the
#: end timestamp to compute a percent against the total audio duration.
_SEGMENT_END_RE = re.compile(
    r"^\[\d+:\d+:\d+[.,]\d+\s*-->\s*"
    r"(\d+):(\d+):(\d+)[.,](\d+)\]"
)


def _format_duration(seconds: float) -> str:
    """Format a duration as '1h 2m 3s', trimming leading zero units."""
    s = int(seconds)
    h, rem = divmod(s, 3600)
    m, sec = divmod(rem, 60)
    if h:
        return f"{h}h {m}m {sec}s"
    if m:
        return f"{m}m {sec}s"
    return f"{sec}s"


class ProgressReporter:
    """Displays transcription progress on stderr.

    Two kinds of messages are handled:

    * **Persistent**: real progress lines (transcript segments, phase
      transitions such as "Converting ..." or "Running diarization ...").
      Printed once and left on screen.
    * **Ephemeral**: heartbeat markers from the server ("⏳ ..."). In TTY
      mode these do not print as their own line; they only bump the
      "last activity" timestamp, and the bottom status line reflects
      liveness. In pipe mode they are forwarded as plain lines so
      downstream consumers (app.py) still see periodic liveness signals
      and can keep their SSE connection warm.

    On a TTY, a bottom status line is continuously updated in place.
    Its content depends on what we know:

      [Heartbeat Alive (Xs ago)]
      [Transcription | Heartbeat Alive (Xs ago)]
      [Transcription at 42% | Heartbeat Alive (Xs ago)]
      [Diarization at 63% | Heartbeat Alive (Xs ago)]
      [Diarization at 63% | Heartbeat Missed! (last 34s ago)]

    The percent for transcription is derived from the last whisper-cli
    segment timestamp seen and the total audio duration (both known to
    the caller). The percent for diarization is derived from the
    "embedding N/M" lines emitted by the patched diarize library and
    forwarded by the SSE bridge. When neither is available (e.g. the
    whisper-server path with no per-segment output), the percent is
    omitted and only the phase label is shown.
    """

    #: Server-side keep-alive markers. Anything starting with this prefix
    #: is treated as ephemeral (status-line only, no new line printed).
    HEARTBEAT_PREFIX = "⏳"

    def __init__(
        self,
        heartbeat_interval: float = 15.0,
        total_duration: float = 0.0,
        start_time: float | None = None,
    ):
        self.heartbeat_interval = heartbeat_interval
        self.total_duration = float(total_duration) if total_duration else 0.0
        self.tty = sys.stderr.isatty()
        self._lock = threading.Lock()
        self._last_event = time.monotonic()
        self._running = True
        self._start_time = start_time if start_time is not None else time.monotonic()
        # Phase/percent are inferred from progress messages. Initial
        # phase is Transcription; percent is 0 if we know the duration,
        # None otherwise (we'll render "Transcription" without a %).
        self._phase: str | None = "Transcription"
        self._percent: float | None = 0.0 if self.total_duration > 0 else None
        self._thread = threading.Thread(target=self._status_loop, daemon=True)
        if self.tty:
            self._thread.start()

    def _update_progress_from_message(self, message: str) -> None:
        """Parse phase/percent hints from a progress message.

        Caller must hold ``self._lock``. Unrecognised messages are
        ignored (they're still printed/forwarded normally).
        """
        # Diarization embedding counter from the patched library:
        # "embedding N/M". No emoji prefix; this comes straight from
        # the diarize logger via the SSE bridge.
        m = re.match(r"^embedding (\d+)/(\d+)\s*$", message)
        if m:
            n, total_n = int(m.group(1)), int(m.group(2))
            self._phase = "Diarization"
            self._percent = 100.0 * n / total_n if total_n > 0 else None
            return

        # Phase transition markers emitted by openai_proxy.py.
        if message.startswith("🎙️"):
            self._phase = "Diarization"
            self._percent = 0.0
            return
        if message.startswith("🎵"):
            self._phase = "Transcription"
            self._percent = 0.0 if self.total_duration > 0 else None
            return

        # whisper-cli segment line — compute transcript progress.
        m = _SEGMENT_END_RE.match(message)
        if m and self.total_duration > 0:
            h, mm, ss, ms = (int(x) for x in m.groups())
            end = h * 3600 + mm * 60 + ss + ms / 1000.0
            pct = max(0.0, min(100.0, 100.0 * end / self.total_duration))
            self._phase = "Transcription"
            # Do not regress; segment timestamps can jitter by a few ms
            # at window boundaries.
            if self._percent is None or pct >= self._percent:
                self._percent = pct
            return

    def _render_status_locked(self) -> None:
        """Draw the bottom status line. Caller must hold ``self._lock``."""
        elapsed = time.monotonic() - self._last_event
        if elapsed > self.heartbeat_interval * 2:
            hb = f"Heartbeat Missed! (last {int(elapsed)}s ago)"
        else:
            hb = f"Heartbeat Alive ({int(elapsed)}s ago)"

        elapsed_str = _format_duration(time.monotonic() - self._start_time)
        tail = f"{hb} | Elapsed {elapsed_str}"

        if self._phase is not None and self._percent is not None:
            status = f"[{self._phase} at {int(self._percent)}% | {tail}]"
        elif self._phase is not None:
            status = f"[{self._phase} | {tail}]"
        else:
            status = f"[{tail}]"

        sys.stderr.write(f"\r\033[K{status}")
        sys.stderr.flush()

    def progress(self, message: str) -> None:
        with self._lock:
            self._last_event = time.monotonic()
            self._update_progress_from_message(message)
            if not self.tty:
                # Pipe mode: forward everything verbatim so the parent
                # process sees regular lines on stderr.
                sys.stderr.write(f"{message}\n")
                sys.stderr.flush()
                return
            if message.startswith(self.HEARTBEAT_PREFIX):
                # Ephemeral: redraw the status line with the fresh
                # timestamp. Do not print the message itself.
                self._render_status_locked()
                return
            # Persistent: clear the bottom line, print the message, then
            # redraw the bottom line *in the same critical section* so
            # there is no visible gap between the two writes.
            sys.stderr.write("\r\033[K")
            sys.stderr.write(f"{message}\n")
            sys.stderr.flush()
            self._render_status_locked()

    def _status_loop(self) -> None:
        while self._running:
            time.sleep(1.0)
            with self._lock:
                self._render_status_locked()

    def stop(self) -> None:
        """Stop the status thread and clear the live status line."""
        self._running = False
        if self.tty:
            self._thread.join(timeout=2.0)
            with self._lock:
                sys.stderr.write("\r\033[K")
                sys.stderr.flush()

    def finalize(self, audio_duration: float, diarized: bool) -> None:
        """Stop the status thread and print a final summary line to stderr.

        Combines what ``stop()`` does (clear the live status line) with a
        human-readable summary: how much audio was transcribed, whether
        diarization ran, and total wall-clock time since ``_start_time``.
        Called on the success path only; failures should use ``stop()``.
        """
        self._running = False
        if self.tty:
            self._thread.join(timeout=2.0)
        with self._lock:
            elapsed_str = _format_duration(time.monotonic() - self._start_time)
            if audio_duration and audio_duration > 0:
                dur_str = _format_duration(audio_duration)
            else:
                dur_str = "unknown-duration"
            mode = " (with diarization)" if diarized else ""
            if self.tty:
                sys.stderr.write("\r\033[K")
            sys.stderr.write(
                f"✅ Transcribed {dur_str} of audio{mode} in {elapsed_str}\n"
            )
            sys.stderr.flush()


def transcribe_file_streaming(
    file_path: str,
    server_url: str,
    reporter: ProgressReporter,
    language: str = None,
    output_format: str = "text",
    diarize: bool = False,
    num_speakers: int = None,
):
    """Consume SSE from the streaming endpoint, forwarding progress lines
    to *reporter*. Returns the final result payload, or None if the
    endpoint is 404 (caller should fall back to non-streaming)."""
    url = server_url.rstrip("/") + STREAM_ENDPOINT
    with open(file_path, "rb") as f:
        files = {"file": (os.path.basename(file_path), f, "audio/mpeg")}
        data = {"response_format": output_format}
        if language:
            data["language"] = language
        if diarize:
            data["diarize"] = "true"
            if num_speakers is not None:
                data["num_speakers"] = str(num_speakers)

        try:
            resp = requests.post(
                url, files=files, data=data, stream=True, timeout=(15, 90)
            )
        except requests.exceptions.RequestException as e:
            raise RuntimeError(f"Request failed: {e}")

        if resp.status_code == 404:
            resp.close()
            return None
        if resp.status_code != 200:
            raise RuntimeError(f"Server returned {resp.status_code}: {resp.text}")

        current_event = None
        event_data: list = []
        try:
            for raw in resp.iter_lines(decode_unicode=True):
                line = raw if raw is not None else ""
                if line == "":
                    if current_event == "result":
                        return "\n".join(event_data)
                    elif current_event == "error":
                        raise RuntimeError("\n".join(event_data))
                    current_event = None
                    event_data = []
                    continue
                if line.startswith("event:"):
                    current_event = line.split(":", 1)[1].strip()
                    event_data = []
                elif line.startswith("data:"):
                    payload = line.split(":", 1)[1]
                    if payload.startswith(" "):
                        payload = payload[1:]
                    if current_event == "progress":
                        reporter.progress(payload)
                    else:
                        event_data.append(payload)
            raise RuntimeError("Stream ended without a result event")
        finally:
            resp.close()


def main():
    parser = argparse.ArgumentParser(description="Transcribe audio using whisper-server.")
    parser.add_argument("input", help="Local media file or YouTube URL")
    parser.add_argument("--language", "-l", help="Language hint (e.g., 'de')")
    parser.add_argument(
        "--server", default=DEFAULT_SERVER, help=f"Server base URL (default: {DEFAULT_SERVER})"
    )
    parser.add_argument(
        "--estimate-factor",
        type=float,
        default=None,
        help="Manual compute factor (seconds per second of audio). If not set, auto-detected based on backend.",
    )
    parser.add_argument(
        "--output-format",
        "-f",
        choices=["text", "json", "srt"],
        default="text",
        help="Output format: text (plain), json (verbose_json with timestamps), or srt (subtitle file).",
    )
    parser.add_argument(
        "--diarize",
        "-d",
        action="store_true",
        help="Enable speaker diarization (adds speaker labels to segments).",
    )
    parser.add_argument(
        "--num-speakers",
        "-n",
        type=int,
        default=None,
        help="Number of speakers (auto‑detect if omitted, only used with --diarize).",
    )

    args = parser.parse_args()

    try:
        overall_start = time.monotonic()
        with tempfile.TemporaryDirectory() as tmpdir:
            audio_file = obtain_audio(args.input, tmpdir)

            duration = get_audio_duration(audio_file)
            if duration > 0:
                # Auto-detect backend if factor not provided
                if args.estimate_factor is not None:
                    factor = args.estimate_factor
                else:
                    backend = get_backend(args.server)
                    if backend == "cpu":
                        factor = 0.15
                    elif backend in ("rocm", "nvidia"):
                        factor = 0.04
                    else:
                        factor = 0.15  # fallback

                    if args.diarize:
                        factor *= 2
                est_seconds = duration * factor
                if est_seconds < 60:
                    est_str = f"{int(est_seconds)} seconds"
                elif est_seconds < 3600:
                    est_str = (
                        f"{int(est_seconds // 60)} minutes and {int(est_seconds % 60)} seconds"
                    )
                else:
                    est_str = f"{int(est_seconds // 3600)} hours"
            else:
                est_str = "unknown"

            format_map = {"text": "text", "json": "verbose_json", "srt": "srt"}
            server_format = format_map[args.output_format]

            if duration > 0:
                log(f"🎵 Audio duration: {_format_duration(duration)} ({duration:.1f}s)")

            mode = "with diarization" if args.diarize else "without diarization"
            speakers = ""
            if args.diarize and args.num_speakers:
                speakers = f", {args.num_speakers} speakers"
            log(f"🎧 Transcribing in {args.output_format} format ({mode}{speakers}) — ETA: {est_str}")

            reporter = ProgressReporter(total_duration=duration, start_time=overall_start)
            response_text = None
            try:
                response_text = transcribe_file_streaming(
                    audio_file,
                    args.server,
                    reporter,
                    language=args.language,
                    output_format=server_format,
                    diarize=args.diarize,
                    num_speakers=args.num_speakers,
                )
                if response_text is None:
                    log("(Streaming endpoint unavailable; falling back to non-streaming)")
                    response_text = transcribe_file(
                        audio_file,
                        args.server,
                        args.language,
                        output_format=server_format,
                        diarize=args.diarize,
                        num_speakers=args.num_speakers,
                    )
            except Exception:
                reporter.stop()
                raise
            reporter.finalize(duration, args.diarize)

            if args.output_format == "json":
                try:
                    data = json.loads(response_text)
                    print(json.dumps(data, indent=2, ensure_ascii=False))
                except json.JSONDecodeError:
                    print(response_text)
            else:
                print(response_text)

    except KeyboardInterrupt:
        log("\nTranscription cancelled by user.")
        sys.exit(130)
    except Exception as e:
        log(f"Error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
