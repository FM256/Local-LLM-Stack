#!/usr/bin/env python3
"""
transcribe.py - Transcribe audio from a local file or YouTube URL using whisper-server.

Usage:
    ./transcribe.py [--language LANG] [--server URL] [--output-format {text,json,srt}]
                    [--diarize] [--num-speakers N] <input>

    <input>           : path to a local audio/video file, or a YouTube URL.
    --language, -l    : ISO-639-1 language code (e.g., 'de') to hint the model.
    --server          : base URL of whisper-server REST API (default: http://localhost:9091).
    --output-format, -f : output format: text (default), json (verbose_json with timestamps), or srt.
    --diarize, -d     : enable speaker diarization (adds speaker labels to segments).
    --num-speakers, -n : number of speakers (auto‑detect if omitted, only used with --diarize).
    --estimate-factor : manually override the compute factor (seconds per second of audio).
    --help, -h        : show this help.

All status output goes to stderr; only the final transcript is printed to stdout.
"""

import argparse
import glob
import json
import os
import shutil
import subprocess
import sys
import tempfile
from urllib.parse import urlparse

import requests

DEFAULT_SERVER = "http://localhost:9091"
TRANSCRIPT_ENDPOINT = "/v1/audio/transcriptions"


def is_url(string: str) -> bool:
    try:
        result = urlparse(string)
        return all([result.scheme, result.netloc])
    except Exception:
        return False


def check_dependency(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def log(msg: str) -> None:
    print(msg, file=sys.stderr)


def get_audio_duration(file_path: str) -> float:
    if not check_dependency("ffprobe"):
        log("Warning: ffprobe not available, cannot estimate time.")
        return 0.0
    cmd = [
        "ffprobe",
        "-v",
        "error",
        "-show_entries",
        "format=duration",
        "-of",
        "default=noprint_wrappers=1:nokey=1",
        file_path,
    ]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        return float(result.stdout.strip())
    except Exception:
        log("Warning: could not read audio duration for time estimate.")
        return 0.0


def get_backend(server_url: str) -> str:
    try:
        resp = requests.get(server_url.rstrip("/") + "/backend", timeout=5)
        if resp.status_code == 200:
            data = resp.json()
            return data.get("backend", "unknown")
    except Exception:
        pass
    return "unknown"


def download_youtube_audio(url: str, output_dir: str) -> str:
    if not check_dependency("yt-dlp"):
        raise RuntimeError("yt-dlp is not installed.")
    # Use a generic base name – yt‑dlp will add the correct extension
    base_path = os.path.join(output_dir, "audio.%(ext)s")
    cmd = [
        "yt-dlp",
        "-f",
        "bestaudio/best[ext=mp4]/best",
        "--no-playlist",
        "--extractor-args",  # Use android client to decrease likelihood of lockouts and rate limiting.
        "youtube:player_client=android",  # This gives lower quality video and audio, but thats completely fine for transcribing
        "--impersonate",  # Use curl_cffi & curl_impersonate to impersonate a real browser to avoid lockouts
        "chrome",
        "--sleep-requests",  # Further arguments to avoid rate limiting and lockouts
        "0.5",
        "--sleep-interval",
        "0.5",
        "--max-sleep-interval",
        "2",
        "-o",
        base_path,
        url,
    ]
    result = subprocess.run(cmd, capture_output=True, text=True, cwd=output_dir)
    if result.returncode != 0:
        raise RuntimeError(f"yt-dlp failed:\n{result.stderr}")
    # Find the downloaded file (should be the only one matching audio.*)
    pattern = os.path.join(output_dir, "audio.*")
    files = glob.glob(pattern)
    if not files:
        raise RuntimeError(f"No audio file created with pattern: {pattern}")
    if len(files) > 1:
        raise RuntimeError(f"Multiple audio files found: {files}")
    return files[0]


def convert_local_to_audio(file_path: str, output_dir: str) -> str:
    if not check_dependency("ffmpeg"):
        raise RuntimeError("ffmpeg is not installed.")
    base, ext = os.path.splitext(os.path.basename(file_path))
    ext_lower = ext.lower()
    audio_extensions = {".mp3", ".wav", ".m4a", ".flac", ".ogg", ".aac", ".opus"}
    if ext_lower in audio_extensions:
        dest = os.path.join(output_dir, os.path.basename(file_path))
        shutil.copy2(file_path, dest)
        return dest
    out_mp3 = os.path.join(output_dir, f"{base}.mp3")
    cmd_copy = ["ffmpeg", "-i", file_path, "-vn", "-c:a", "copy", "-y", out_mp3]
    result = subprocess.run(cmd_copy, capture_output=True, text=True)
    if result.returncode == 0 and os.path.isfile(out_mp3) and os.path.getsize(out_mp3) > 0:
        return out_mp3
    log("Copy failed, re‑encoding with libmp3lame.")
    cmd_reencode = [
        "ffmpeg",
        "-i",
        file_path,
        "-vn",
        "-c:a",
        "libmp3lame",
        "-b:a",
        "192k",
        "-y",
        out_mp3,
    ]
    subprocess.run(cmd_reencode, check=True, capture_output=True)
    return out_mp3


def obtain_audio(input_str: str, temp_dir: str) -> str:
    if is_url(input_str):
        log(f"Downloading audio from URL: {input_str}")
        return download_youtube_audio(input_str, temp_dir)
    if not os.path.isfile(input_str):
        raise FileNotFoundError(f"File not found: {input_str}")
    log(f"Processing local file: {input_str}")
    return convert_local_to_audio(input_str, temp_dir)


def transcribe_file(
    file_path: str,
    server_url: str,
    language: str = None,
    output_format: str = "text",
    diarize: bool = False,
    num_speakers: int = None,
) -> str:
    url = server_url.rstrip("/") + TRANSCRIPT_ENDPOINT
    with open(file_path, "rb") as f:
        files = {"file": (os.path.basename(file_path), f, "audio/mpeg")}
        data = {"response_format": output_format}
        if language:
            data["language"] = language
        if diarize:
            data["diarize"] = "true"
            if num_speakers is not None:
                data["num_speakers"] = str(num_speakers)

        try:
            resp = requests.post(url, files=files, data=data, timeout=3600)
        except requests.exceptions.RequestException as e:
            raise RuntimeError(f"Request failed: {e}")

    if resp.status_code != 200:
        raise RuntimeError(f"Server returned {resp.status_code}: {resp.text}")
    return resp.text


def main():
    parser = argparse.ArgumentParser(description="Transcribe audio using whisper-server.")
    parser.add_argument("input", help="Local media file or YouTube URL")
    parser.add_argument("--language", "-l", help="Language hint (e.g., 'de')")
    parser.add_argument(
        "--server", default=DEFAULT_SERVER, help=f"Server base URL (default: {DEFAULT_SERVER})"
    )
    parser.add_argument(
        "--estimate-factor",
        type=float,
        default=None,
        help="Manual compute factor (seconds per second of audio). If not set, auto-detected based on backend.",
    )
    parser.add_argument(
        "--output-format",
        "-f",
        choices=["text", "json", "srt"],
        default="text",
        help="Output format: text (plain), json (verbose_json with timestamps), or srt (subtitle file).",
    )
    parser.add_argument(
        "--diarize",
        "-d",
        action="store_true",
        help="Enable speaker diarization (adds speaker labels to segments).",
    )
    parser.add_argument(
        "--num-speakers",
        "-n",
        type=int,
        default=None,
        help="Number of speakers (auto‑detect if omitted, only used with --diarize).",
    )

    args = parser.parse_args()

    try:
        with tempfile.TemporaryDirectory() as tmpdir:
            audio_file = obtain_audio(args.input, tmpdir)

            duration = get_audio_duration(audio_file)
            if duration > 0:
                # Auto-detect backend if factor not provided
                if args.estimate_factor is not None:
                    factor = args.estimate_factor
                else:
                    backend = get_backend(args.server)
                    if backend == "cpu":
                        factor = 0.15
                    elif backend in ("rocm", "nvidia"):
                        factor = 0.04
                    else:
                        factor = 0.15  # fallback

                    if args.diarize:
                        factor *= 2
                est_seconds = duration * factor
                if est_seconds < 60:
                    est_str = f"{int(est_seconds)} seconds"
                elif est_seconds < 3600:
                    est_str = (
                        f"{int(est_seconds // 60)} minutes and {int(est_seconds % 60)} seconds"
                    )
                else:
                    est_str = f"{int(est_seconds // 3600)} hours"
            else:
                est_str = "unknown"

            format_map = {"text": "text", "json": "verbose_json", "srt": "srt"}
            server_format = format_map[args.output_format]

            log(f"Transcribing in {args.output_format} format... (ETA: {est_str})")
            if args.diarize:
                log(f"  Diarization enabled (speakers: {args.num_speakers or 'auto'})")

            response_text = transcribe_file(
                audio_file,
                args.server,
                args.language,
                output_format=server_format,
                diarize=args.diarize,
                num_speakers=args.num_speakers,
            )

            if args.output_format == "json":
                try:
                    data = json.loads(response_text)
                    print(json.dumps(data, indent=2, ensure_ascii=False))
                except json.JSONDecodeError:
                    print(response_text)
            else:
                print(response_text)

    except KeyboardInterrupt:
        log("\nTranscription cancelled by user.")
        sys.exit(130)
    except Exception as e:
        log(f"Error: {e}")
        sys.exit(1)


if __name__ == "__main__":
    main()
